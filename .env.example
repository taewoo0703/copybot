# App settings
# Save the real .env file in the parent folder of this project.
# Example: C:\Home\copybot_env\.env when this repo is C:\Home\lscopybot
PASSWORD=
COPYBOT_CONFIG_PATH=C:/Home/copybot/config/copybot.example.yaml
DISCORD_WEBHOOK_URL=
WHITELIST=[]
PORT=8000
USE_WHITELIST=0

# Account credentials
# The prefix must match credentials_ref in config/copybot.example.yaml.

# credentials_ref: DOMESTIC_MASTER
DOMESTIC_MASTER_APP_KEY=
DOMESTIC_MASTER_APP_SECRET=
DOMESTIC_MASTER_IS_MOCK=0

# credentials_ref: DOMESTIC_SLAVE
DOMESTIC_SLAVE_APP_KEY=
DOMESTIC_SLAVE_APP_SECRET=
DOMESTIC_SLAVE_IS_MOCK=0
