# App settings
# Save the real .env file in the parent folder of this project.
# Example: C:\Home\copybot_env\.env when this repo is C:\Home\lscopybot
PASSWORD=
COPYBOT_CONFIG_PATH=C:/Home/copybot/config/copybot.example.yaml
DISCORD_WEBHOOK_URL=
WHITELIST=[]
PORT=8000
USE_WHITELIST=0

# Account credentials
# The prefix must match credentials_ref in config/copybot.example.yaml.

# credentials_ref: DOMESTIC_MASTER
DOMESTIC_MASTER_APP_KEY=
DOMESTIC_MASTER_APP_SECRET=
DOMESTIC_MASTER_ACCOUNT_NO=
DOMESTIC_MASTER_ACCOUNT_PASSWORD=
DOMESTIC_MASTER_ACCESS_TOKEN=
DOMESTIC_MASTER_BASE_URL=
DOMESTIC_MASTER_IS_MOCK=0

# Optional REST endpoint paths for DOMESTIC_MASTER
DOMESTIC_MASTER_DOMESTIC_BALANCE_PATH=
DOMESTIC_MASTER_DOMESTIC_ORDER_PATH=
DOMESTIC_MASTER_DOMESTIC_QUOTE_PATH=
DOMESTIC_MASTER_GLOBAL_BALANCE_PATH=
DOMESTIC_MASTER_GLOBAL_ORDER_PATH=
DOMESTIC_MASTER_GLOBAL_QUOTE_PATH=
DOMESTIC_MASTER_BALANCE_TR_ID=
DOMESTIC_MASTER_ORDER_TR_ID=
DOMESTIC_MASTER_QUOTE_TR_ID=

# credentials_ref: DOMESTIC_SLAVE
DOMESTIC_SLAVE_APP_KEY=
DOMESTIC_SLAVE_APP_SECRET=
DOMESTIC_SLAVE_ACCOUNT_NO=
DOMESTIC_SLAVE_ACCOUNT_PASSWORD=
DOMESTIC_SLAVE_ACCESS_TOKEN=
DOMESTIC_SLAVE_BASE_URL=
DOMESTIC_SLAVE_IS_MOCK=0

# Optional REST endpoint paths for DOMESTIC_SLAVE
DOMESTIC_SLAVE_DOMESTIC_BALANCE_PATH=
DOMESTIC_SLAVE_DOMESTIC_ORDER_PATH=
DOMESTIC_SLAVE_DOMESTIC_QUOTE_PATH=
DOMESTIC_SLAVE_GLOBAL_BALANCE_PATH=
DOMESTIC_SLAVE_GLOBAL_ORDER_PATH=
DOMESTIC_SLAVE_GLOBAL_QUOTE_PATH=
DOMESTIC_SLAVE_BALANCE_TR_ID=
DOMESTIC_SLAVE_ORDER_TR_ID=
DOMESTIC_SLAVE_QUOTE_TR_ID=
